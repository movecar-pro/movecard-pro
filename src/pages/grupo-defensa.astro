---
const paths = {
  car: '<path d="m5 10 2-5h10l2 5M5 10h14v8H5zM7 18v2m10-2v2M7 14h1m8 0h1"/>',
  shield: '<path d="m12 3 8 4v6c0 5-8 8-8 8s-8-3-8-8V7z"/><path d="m8 12 3 3 5-6"/>',
  tool: '<path d="M14 6a5 5 0 0 0-6 6l-5 5a2 2 0 0 0 3 3l5-5a5 5 0 0 0 6-6l-3 3-3-3z"/>',
  phone: '<rect x="6" y="2" width="12" height="20" rx="2"/><path d="m9 13 2-3 2 2 2-4M11 18h2"/>',
};

import { legalDocs } from '../lib/content';
import { content } from '../lib/defensa-content.js';
const message = '¡Hola! Quiero postular a Movecar.pro. Vengo de Grupo Defensa. Código: GD-LAB.';
// Contenedor exclusivo para landing pages de campañas. No modificar GTM global de Movecar.
const gtmId = 'GTM-T7T48J87';
const whatsappUrl = `https://api.whatsapp.com/send?phone=56988660473&text=${encodeURIComponent(message)}`;
---

<!doctype html>
<html lang="es-CL">
  <head>
    <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Grupo Defensa × Movecar.pro | Agenda tu entrevista</title>
    <meta
      name="description"
      content="Arrienda un auto por semana con Movecar.pro. Conoce los requisitos y agenda tu entrevista por WhatsApp."
    />

    <meta name="theme-color" content="#0e1424" />
    <link rel="icon" href="/defensa-deudores/assets/favicon.svg" type="image/svg+xml" />
    <link rel="stylesheet" href="/defensa-deudores/styles.css" />
    <link rel="canonical" href="https://www.movecar.pro/grupo-defensa" />
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <header class="site-header">
      <div class="brand-row container">
        <img
          class="gd-logo"
          src="/defensa-deudores/assets/grupo-defensa.svg"
          width="400"
          height="132"
          alt="Grupo Defensa"
        /><span class="brand-cross" aria-hidden="true">×</span><img
          class="mc-logo"
          src="/defensa-deudores/assets/movecar.png"
          width="374"
          height="46"
          alt="Movecar.pro"
        />
      </div>
    </header>
    <main id="contenido">
      <section class="hero">
        <div class="hero-grid container">
          <div class="hero-copy">
            <p class="eyebrow"><span aria-hidden="true"></span>30% de descuento en tu primer mes</p>
            <h1>Genera ingresos manejando, <em>sin comprar auto</em></h1>
            <p class="lead">
              En Grupo Defensa queremos acompañarte más allá de la asesoría. Por eso nos aliamos
              con Movecar.pro: como cliente, puedes postular con condiciones preferentes.
            </p>
            <div class="hero-photo mobile-photo">
              <img
                src="/defensa-deudores/assets/grupo-defensa-figma-2x.svg"
                alt="Conductor al volante de un auto naranja Movecar.pro"
                width="700"
                height="525"
                fetchpriority="high"
              />
            </div>
            <div class="contact-block">
              <a class="cta" href={whatsappUrl} target="_blank" rel="noopener noreferrer"
                ><span class="icon" aria-hidden="true"
                  ><svg aria-hidden="true" focusable="false" width="22" height="22" viewBox="0 0 22 22" fill="none" xmlns="http://www.w3.org/2000/svg">
<path d="M10.9999 1.83331C9.38196 1.8336 7.79291 2.26211 6.39417 3.07532C4.99544 3.88854 3.83686 5.05748 3.03614 6.46341C2.23541 7.86933 1.82107 9.46214 1.8352 11.08C1.84933 12.6979 2.29143 14.2833 3.11659 15.675L1.83325 20.1666L6.41658 18.975C7.63482 19.6653 8.99501 20.0674 10.3928 20.1503C11.7906 20.2333 13.1888 19.9949 14.4801 19.4535C15.7714 18.9121 16.9216 18.0821 17.8423 17.0271C18.7629 15.9721 19.4297 14.7203 19.7914 13.3676C20.1531 12.0148 20.2001 10.5973 19.9288 9.22356C19.6574 7.84987 19.075 6.55659 18.2262 5.44296C17.3774 4.32934 16.2848 3.42497 15.0321 2.79925C13.7795 2.17353 12.4001 1.8431 10.9999 1.83331ZM10.9999 18.5166C9.64073 18.5048 8.31019 18.1247 7.14992 17.4166L6.87492 17.2333L4.12492 17.9666L4.85825 15.3083L4.67492 15.0333C3.77925 13.6248 3.37791 11.9581 3.53419 10.2963C3.69047 8.63437 4.39548 7.07179 5.53804 5.8549C6.6806 4.63801 8.19571 3.83605 9.84446 3.57548C11.4932 3.31491 13.1818 3.61056 14.6439 4.41579C16.1061 5.22103 17.2586 6.49005 17.9197 8.02274C18.5809 9.55543 18.7131 11.2646 18.2954 12.8807C17.8778 14.4968 16.9341 15.928 15.6131 16.9484C14.2922 17.9689 12.6691 18.5206 10.9999 18.5166ZM15.1249 12.925C14.9416 12.8333 13.7499 12.2833 13.5666 12.1916C13.3833 12.1 13.1999 12.1 13.0166 12.2833C12.8333 12.4666 12.3749 13.0166 12.2833 13.2C12.1916 13.3833 12.0083 13.3833 11.8249 13.2916C10.5465 12.7707 9.48083 11.8342 8.79992 10.6333C8.61659 10.2666 8.98325 10.2666 9.44159 9.44165C9.53325 9.25831 9.44159 9.16665 9.44159 9.07498L8.70825 7.42498C8.52492 6.96665 8.34158 7.05831 8.15825 7.05831H7.69992C7.45813 7.06176 7.2275 7.1606 7.05825 7.33331C6.79061 7.59552 6.57937 7.90966 6.4375 8.25645C6.29563 8.60324 6.22613 8.97536 6.23325 9.34998C6.32648 10.2543 6.67634 11.113 7.24159 11.825C8.30494 13.3926 9.75818 14.6563 11.4583 15.4916C13.0166 16.1333 13.6583 16.225 14.3916 16.1333C14.7333 16.0577 15.056 15.913 15.3398 15.708C15.6235 15.5031 15.8623 15.2423 16.0416 14.9416C16.2174 14.5707 16.2811 14.1566 16.2249 13.75C16.1333 13.6583 16.0416 13.5666 15.8583 13.475L15.1249 12.925Z" fill="#1A1206"/>
</svg></span
                ><span>Agenda tu entrevista</span></a
              ><p class="caption">Sin costo ni compromiso.</p>
            </div>
          </div><div class="hero-photo desktop-photo">
            <img
              src="/defensa-deudores/assets/grupo-defensa-figma-2x.svg"
              alt="Conductor al volante de un auto naranja Movecar.pro"
              width="700"
              height="525"
              fetchpriority="high"
            />
          </div>
        </div>
      </section>
      <section class="steps-section section">
        <div class="container">
          <h2>Tu entrevista en 3 pasos</h2><ol class="steps">
            {
              content.steps.map(([title, description], i) => (
                <li>
                  <>
                    <span class="step-number">{i + 1}</span>
                    <div>
                      <>
                        <h3>{title}</h3>
                        <p>{description}</p>
                      </>
                    </div>
                  </>
                </li>
              ))
            }
          </ol>
        </div>
      </section>
      <section class="included section">
        <div class="container">
          <h2>Qué incluye</h2><aside class="offer">
            <p class="overline">Beneficio Grupo Defensa</p><h3 id="benefit-title">
              30% de DESCUENTO en tu primer mes
            </h3><p id="weekly-price">Planes semanales desde 1,9 UF.</p>
          </aside><div class="cost-panel" aria-label="Detalle de costos">
  <h3>Costos del arriendo</h3>
  <dl class="cost-grid">
    <div><dt>Arriendo semanal</dt><dd>desde 1,9 UF</dd></div>
    <div><dt>Costo mensual aprox.</dt><dd>desde 8,2 UF</dd></div>
    <div><dt>Primer mes con 30% dcto.</dt><dd>desde 5,8 UF</dd></div>
    <div><dt>Garantía</dt><dd>$350.000 CLP</dd></div>
  </dl>
  <p>Valores referenciales. Las condiciones definitivas se confirman durante la entrevista.</p>
</div><div class="benefits">
            {
              content.benefits.map(([name, title, description]) => (
                <article class="benefit">
                  <>
                    <span class="icon" aria-hidden="true">
                      <svg
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.8"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        set:html={paths[name]}
                      />
                    </span>
                    <h3>{title}</h3>
                    <p>{description}</p>
                  </>
                </article>
              ))
            }
          </div>
        </div>
      </section>
      <section class="requirements-section section">
        <div class="requirements-grid container">
          <div>
            <h2>Ten a mano</h2><ul class="requirements">
              {
                content.requirements.map((value) => (
                  <li>
                    <>
                      <span class="check" aria-hidden="true">
                        ✓
                      </span>
                      <span>{value}</span>
                    </>
                  </li>
                ))
              }
            </ul><p class="location">
              <span aria-hidden="true">⌖</span><span
                ><strong>Requisito:</strong> vivir en la Región Metropolitana.</span>
            </p>
          </div><aside class="last-cta">
            <p class="overline">Da el siguiente paso</p><h2>¿Listo? Agenda<br />tu entrevista</h2><p
            >
              No necesitas llenar formularios: todo es por WhatsApp.
            </p><div class="contact-block">
              <a class="cta" href={whatsappUrl} target="_blank" rel="noopener noreferrer"
                ><span class="icon" aria-hidden="true"
                  ><svg aria-hidden="true" focusable="false" width="22" height="22" viewBox="0 0 22 22" fill="none" xmlns="http://www.w3.org/2000/svg">
<path d="M10.9999 1.83331C9.38196 1.8336 7.79291 2.26211 6.39417 3.07532C4.99544 3.88854 3.83686 5.05748 3.03614 6.46341C2.23541 7.86933 1.82107 9.46214 1.8352 11.08C1.84933 12.6979 2.29143 14.2833 3.11659 15.675L1.83325 20.1666L6.41658 18.975C7.63482 19.6653 8.99501 20.0674 10.3928 20.1503C11.7906 20.2333 13.1888 19.9949 14.4801 19.4535C15.7714 18.9121 16.9216 18.0821 17.8423 17.0271C18.7629 15.9721 19.4297 14.7203 19.7914 13.3676C20.1531 12.0148 20.2001 10.5973 19.9288 9.22356C19.6574 7.84987 19.075 6.55659 18.2262 5.44296C17.3774 4.32934 16.2848 3.42497 15.0321 2.79925C13.7795 2.17353 12.4001 1.8431 10.9999 1.83331ZM10.9999 18.5166C9.64073 18.5048 8.31019 18.1247 7.14992 17.4166L6.87492 17.2333L4.12492 17.9666L4.85825 15.3083L4.67492 15.0333C3.77925 13.6248 3.37791 11.9581 3.53419 10.2963C3.69047 8.63437 4.39548 7.07179 5.53804 5.8549C6.6806 4.63801 8.19571 3.83605 9.84446 3.57548C11.4932 3.31491 13.1818 3.61056 14.6439 4.41579C16.1061 5.22103 17.2586 6.49005 17.9197 8.02274C18.5809 9.55543 18.7131 11.2646 18.2954 12.8807C17.8778 14.4968 16.9341 15.928 15.6131 16.9484C14.2922 17.9689 12.6691 18.5206 10.9999 18.5166ZM15.1249 12.925C14.9416 12.8333 13.7499 12.2833 13.5666 12.1916C13.3833 12.1 13.1999 12.1 13.0166 12.2833C12.8333 12.4666 12.3749 13.0166 12.2833 13.2C12.1916 13.3833 12.0083 13.3833 11.8249 13.2916C10.5465 12.7707 9.48083 11.8342 8.79992 10.6333C8.61659 10.2666 8.98325 10.2666 9.44159 9.44165C9.53325 9.25831 9.44159 9.16665 9.44159 9.07498L8.70825 7.42498C8.52492 6.96665 8.34158 7.05831 8.15825 7.05831H7.69992C7.45813 7.06176 7.2275 7.1606 7.05825 7.33331C6.79061 7.59552 6.57937 7.90966 6.4375 8.25645C6.29563 8.60324 6.22613 8.97536 6.23325 9.34998C6.32648 10.2543 6.67634 11.113 7.24159 11.825C8.30494 13.3926 9.75818 14.6563 11.4583 15.4916C13.0166 16.1333 13.6583 16.225 14.3916 16.1333C14.7333 16.0577 15.056 15.913 15.3398 15.708C15.6235 15.5031 15.8623 15.2423 16.0416 14.9416C16.2174 14.5707 16.2811 14.1566 16.2249 13.75C16.1333 13.6583 16.0416 13.5666 15.8583 13.475L15.1249 12.925Z" fill="#1A1206"/>
</svg></span
                ><span>Agenda tu entrevista</span></a>
            </div>
          </aside>
        </div>
      </section>
      <section class="faq-section section">
        <div class="faq-container container">
          <h2>Preguntas frecuentes</h2><div class="faqs">
            {
              content.faqs.map(([question, answer]) => (
                <details>
                  <>
                    <summary>
                      {question}
                      <span class="faq-toggle" aria-hidden="true">
                        +
                      </span>
                    </summary>
                    <p>{answer}</p>
                  </>
                </details>
              ))
            }
          </div>
        </div>
      </section>
    </main>
    <footer class="site-footer">
      <div class="container">
        <div class="brand-row">
          <img
            class="gd-logo"
            src="/defensa-deudores/assets/grupo-defensa.svg"
            width="400"
            height="132"
            alt="Grupo Defensa"
          /><span class="brand-cross" aria-hidden="true">×</span><img
            class="mc-logo"
            src="/defensa-deudores/assets/movecar.png"
            width="374"
            height="46"
            alt="Movecar.pro"
          />
        </div><p>Una alianza Grupo Defensa × Movecar.pro</p><p>
          Movecar.pro es una marca de Moverent SpA
        </p><details class="privacy-document">
          <summary>Política de Privacidad</summary><div class="privacy-copy">
            <h2>{legalDocs.privacy.title}</h2><p>{legalDocs.privacy.updated}</p>{
              legalDocs.privacy.sections.map((section) => (
                <section>
                  <h3>{section.heading}</h3>
                  {section.body.map((block) =>
                    typeof block === 'string' ? (
                      <p>{block}</p>
                    ) : 'list' in block ? (
                      <ul>
                        {block.list.map((item) => (
                          <li>{item}</li>
                        ))}
                      </ul>
                    ) : 'sub' in block ? (
                      <h4>{block.sub}</h4>
                    ) : (
                      <table>
                        {block.table.map((row) => (
                          <tr>
                            {row.map((cell) => (
                              <td>{cell}</td>
                            ))}
                          </tr>
                        ))}
                      </table>
                    ),
                  )}
                </section>
              ))
            }
          </div>
        </details>
      </div>
    </footer>
    <script is:inline src="/defensa-deudores/analytics.js" data-gtm-id={gtmId} data-campaign="GD-LAB" defer></script>
  </body>
</html>
