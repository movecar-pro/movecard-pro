---
import '../../styles/global.css';
---
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Tu postulación | MoveCar</title>
  </head>
  <body>
    <header><div class="shell"><a href="/" aria-label="MoveCar, inicio"><img src="/assets/logos/movecar-logotipo.svg" width="190" height="27" alt="MoveCar.Pro" /></a></div></header>
    <main class="shell">
      <span id="etiqueta">REVISA TU ENLACE</span>
      <h1 id="titulo">No pudimos registrar tu respuesta</h1>
      <p id="detalle">Vuelve a abrir el enlace del correo para intentarlo nuevamente.</p>
      <ul id="beneficios" hidden>
        <li><span><svg viewBox="0 0 24 24"><path d="m13 2-9 12h7l-1 8 10-13h-8z" /></svg></span>Maneja un auto eléctrico o a bencina</li>
        <li><span><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" /></svg></span>Conduce según los ingresos que buscas</li>
        <li><span><svg viewBox="0 0 24 24"><path d="M4 14v-3a8 8 0 0 1 16 0v3M4 13H3v6h4v-6zm16 0h1v6h-4v-6z" /></svg></span>Un equipo de soporte que te acompaña</li>
      </ul>
      <noscript><p>Activa JavaScript para ver el estado de tu respuesta.</p></noscript>
    </main>
    <footer><div class="shell"><span>MOVERENT SpA · MoveCar</span><a href="/">movecar.pro</a></div></footer>
  </body>
</html>
<script>
  const mensajes = {
    si: ['CONTINÚA TU POSTULACIÓN', '¡Gracias por confirmar!', 'Nuestro equipo te contactará pronto para que finalices tu postulación con MoveCar'],
    no: ['RESPUESTA REGISTRADA', '¡Gracias por responder!', 'Registramos tu preferencia. No te volveremos a escribir por esta encuesta.'],
    expirado: ['ENLACE VENCIDO', 'Este enlace expiró', 'El enlace de esta encuesta ya no está vigente. No registramos una nueva respuesta.'],
    error: ['REVISA TU ENLACE', 'No pudimos registrar tu respuesta', 'Vuelve a abrir el enlace del correo para intentarlo nuevamente.'],
  };
  const estado = new URLSearchParams(window.location.search).get('estado') ?? 'error';
  const mensaje = Object.hasOwn(mensajes, estado) ? mensajes[estado as keyof typeof mensajes] : mensajes.error;
  ['etiqueta', 'titulo', 'detalle'].forEach((id, i) => {
    const elemento = document.getElementById(id);
    if (elemento) elemento.textContent = mensaje[i];
  });
  const beneficios = document.getElementById('beneficios');
  if (beneficios) beneficios.hidden = estado !== 'si';
</script>
<style>
  :global(body) { margin:0; min-height:100svh; display:flex; flex-direction:column; background:#fff8ef; color:#191510; font-family:Arial,Helvetica,sans-serif; }
  .shell { width:100%; max-width:960px; margin:0 auto; box-sizing:border-box; }
  header { border-bottom:1px solid #eee2d3; }
  header .shell { height:54px; display:flex; align-items:center; }
  main.shell { flex:1; padding:104px 24px 80px; }
  #etiqueta { display:inline-block; background:#ff9500; border-radius:30px; padding:8px 12px; font-size:11px; font-weight:600; }
  h1 { margin:28px 0; font-size:46px; line-height:1.15; letter-spacing:-1.5px; font-weight:700; }
  p { max-width:420px; font-size:16px; line-height:24px; color:#574d43; }
  ul { margin:36px 0 0; padding:0; list-style:none; }
  li { display:flex; align-items:center; gap:12px; margin-top:12px; font-size:14px; }
  li span { display:flex; align-items:center; justify-content:center; width:32px; height:32px; flex-shrink:0; border-radius:10px; background:#ffe6c1; }
  svg { width:16px; height:16px; fill:none; stroke:currentColor; stroke-width:1.8; stroke-linecap:round; stroke-linejoin:round; }
  footer { border-top:1px solid #eee2d3; font-size:11px; color:#756b61; }
  footer .shell { min-height:44px; display:flex; justify-content:space-between; align-items:center; gap:16px; padding-top:12px; padding-bottom:12px; }
  a { color:inherit; text-decoration:none; }
  a:hover { text-decoration:underline; }
  @media(max-width:640px) { header .shell, footer .shell { padding-left:24px; padding-right:24px; } main.shell { padding-top:64px; } h1 { font-size:36px; } }
</style>
